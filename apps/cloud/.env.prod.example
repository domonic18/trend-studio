# 复制为 .env.prod 并填入真实值；.env.prod 不入库。
# 所有值同时用于 docker compose 插值，shell 兼容（KEY=VALUE，不加引号）。
APP_ENV=staging
LOG_LEVEL=info

# 对外地址必须 HTTPS；production 不允许本机地址。
PUBLIC_BASE_URL=https://api.example.com
# 指向 CDN 根（其下可直接取到 hls/index.m3u8）。本地 staging 验证改为
# https://localhost/media，并设置 MEDIA_HOST_DIR + MEDIA_LOCAL_DIR=/media。
MEDIA_BASE_URL=https://media.example.com

# Caddy 站点域名；公网域名自动签发证书。
DOMAIN=api.example.com

# PostgreSQL；compose 会据此拼 DATABASE_URL。
POSTGRES_USER=trend_coach
POSTGRES_PASSWORD=
POSTGRES_DB=trend_coach

# 必填，均至少 16 字符；生成：openssl rand -hex 32
METRICS_TOKEN=
MEDIA_SIGNING_SECRET=

# 首个管理员：仅当库中无 active admin 时创建；两项必须同时配置。
# 密码至少 12 字符。创建成功后移除这两个变量并重启，避免明文长期留在环境。
# BOOTSTRAP_ADMIN_USERNAME=admin01
# BOOTSTRAP_ADMIN_PASSWORD=

# 本地 staging 媒体：默认挂载 ./workspace/media；生产媒体走 CDN，不设置。
# MEDIA_HOST_DIR=./workspace/media
# MEDIA_LOCAL_DIR=/media

# 模型连接（ASR / 内容 LLM / embedding）在后台「模型配置」页维护，密钥加密存库，
# 保存后立即生效。以下为密钥加密盐与后台配置限流。
# CREDENTIAL_ENCRYPTION_KEY 必填（>=32 字符，openssl rand -hex 32）；
# 更换后已存密钥无法解密，需在后台重新录入。
CREDENTIAL_ENCRYPTION_KEY=
RATE_LIMIT_MODEL_CONFIG_PER_MINUTE=60

# 视频→课程管线（M1）。启用时镜像已内置 ffmpeg；两目录必须同一挂载点。
# compose 把 ./workspace/pipeline 挂到 /data；生产 HLS 由 CDN 回源 /data/hls。
# 本地 staging 设 MEDIA_LOCAL_DIR=/media（默认挂载 ./workspace/media），
# 并改用 PIPELINE_STORAGE_DIR=/media/pipeline、PIPELINE_HLS_DIR=/media。
PIPELINE_ENABLED=true
PIPELINE_STORAGE_DIR=/data/storage
PIPELINE_HLS_DIR=/data/hls
PIPELINE_MAX_UPLOAD_BYTES=2147483648
PIPELINE_MAX_SOURCE_SECONDS=14400
PIPELINE_MAX_CONCURRENT_JOBS=1
RATE_LIMIT_PIPELINE_PER_MINUTE=30

# 其余 TTL、限流、召回阈值沿用 src/config.ts 默认值，按需覆盖：
# ACCESS_TTL_SECONDS=900
# SESSION_TTL_SECONDS=43200
# INVITE_TTL_SECONDS=604800
# RATE_LIMIT_SEARCH_PER_MINUTE=120
# RATE_LIMIT_PROGRESS_PER_MINUTE=120
# RATE_LIMIT_LOGIN_PER_MINUTE=10
# RATE_LIMIT_DEVICE_TOKEN_PER_MINUTE=120
# RATE_LIMIT_REFRESH_PER_MINUTE=60
# RATE_LIMIT_CATALOG_PER_MINUTE=240
# RATE_LIMIT_CONTENT_PER_MINUTE=300

{
  "name": "trend-coach-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/index.ts",
    "dev:admin": "vite --config web/admin/vite.config.ts",
    "dev:portal": "vite --config web/portal/vite.config.ts",
    "build": "tsc -p tsconfig.build.json && vite build --config web/admin/vite.config.ts && node scripts/prerender-portal.mjs",
    "build:server": "tsc -p tsconfig.build.json",
    "build:admin": "vite build --config web/admin/vite.config.ts",
    "build:portal": "node scripts/prerender-portal.mjs",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "typecheck": "tsc --noEmit && tsc -p web/admin/tsconfig.json --noEmit && tsc -p web/portal/tsconfig.json --noEmit",
    "check": "tsc --noEmit && tsc -p web/admin/tsconfig.json --noEmit && tsc -p web/portal/tsconfig.json --noEmit",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "seed:glossary": "node --env-file-if-exists=.env --import tsx scripts/seed-glossary.ts",
    "test": "node scripts/verify-test-db.mjs && node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 test/*.test.ts",
    "loadtest": "node scripts/load-test.mjs",
    "drill": "scripts/restore-drill.sh"
  },
  "dependencies": {
    "@trend/contracts": "workspace:*",
    "@trend/widgets": "workspace:*",
    "@ant-design/cssinjs": "^1.24.0",
    "@ant-design/icons": "^5.6.1",
    "@fastify/cors": "^10.0.0",
    "@fastify/static": "^10.1.8",
    "@tanstack/react-query": "^5.105.0",
    "antd": "^5.29.3",
    "dayjs": "^1.11.23",
    "fastify": "^5.0.0",
    "hls.js": "^1.7.4",
    "mermaid": "^12.3.0",
    "pg": "^8.13.0",
    "prom-client": "^15.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "remark-gfm": "^4.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.7",
    "yaml": "^2.6.0"
  }
}

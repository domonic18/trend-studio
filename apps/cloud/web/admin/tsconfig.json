{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@widgets/*": ["../widgets/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "../widgets/**/*.ts", "../widgets/**/*.tsx", "vite.config.ts"]
}
